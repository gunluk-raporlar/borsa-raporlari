# Cloudflare Pages ozel basliklari: tum yanitlara temel guvenlik basliklari.
# Not: Site inline scriptler, Puter.js ve TradingView widget'lari kullandigi
# icin CSP'yi 'unsafe-inline' iceren gevsek bir seviyede tutuyoruz; yine de
# bilinmeyen dis kaynaklari kisitlar.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; img-src 'self' https: data: blob:; connect-src 'self' https: wss:; font-src 'self' https: data:; frame-src 'self' https:; object-src 'none'; base-uri 'self'

# Onbellek: HTML kisa sureli (site gun icinde 30 dk'da bir guncelleniyor;
# daha uzun cache bayat fiyat/sinyal gosterir), degismeyen varliklar 1 gun.
/*.html
  Cache-Control: public, max-age=60
/ticker.json
  Cache-Control: public, max-age=60
/hisse/isi-haritasi.js
  Cache-Control: public, max-age=300
/style.css
  Cache-Control: public, max-age=86400
/og-cover.png
  Cache-Control: public, max-age=86400
